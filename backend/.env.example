OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-6-astra
# A relative path here is resolved against the backend/ folder itself (not
# the current working directory), so it stays correct even if uvicorn is
# started from elsewhere (e.g. --app-dir backend from the repo root). Use an
# absolute path to override that.
DATABASE_PATH=data/receipts.db
